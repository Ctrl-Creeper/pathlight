    "One gitignore-style pattern per line. Matching files and folders are left out of monitoring. Leave empty to record everything.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一条 gitignore 风格的规则。匹配的文件和文件夹不会被监控。留空则记录全部变化。"
          }
        }
      }
    },
